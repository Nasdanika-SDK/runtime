<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	  <parent>
	    <artifactId>parent</artifactId>
	    <groupId>org.nasdanika.sdk.runtime</groupId>
	    <version>2026.10.0</version>
	    <relativePath>..</relativePath>
	  </parent>
	<artifactId>drawio-playwright</artifactId>
	<packaging>jar</packaging>
	<name>Nasdanika SDK Runtime Draw.io Playwright</name>
	<description>
		Draw.io documents rendered with draw.io's own viewer in a browser driven by Playwright: pages
		as PNG and SVG images with the page embedded, so draw.io opens them for editing, and videos of
		pages shown in sequence. Documented in the Draw.io Zephyr Book.
	</description>

	<properties>
		<!--
			The browser the tests drive: an installed one, such as chrome or msedge, or empty for the
			Chromium that Playwright downloads on first use. Tests are skipped if it cannot be launched.
		-->
		<playwright.channel>chrome</playwright.channel>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>bom</artifactId>
				<version>${project.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>	

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<nasdanika.playwright.channel>${playwright.channel}</nasdanika.playwright.channel>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<dependency>
			<groupId>org.json</groupId>
			<artifactId>json</artifactId>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>drawio</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>playwright</artifactId>
			<version>${project.version}</version>
		</dependency>
	</dependencies>
</project>
