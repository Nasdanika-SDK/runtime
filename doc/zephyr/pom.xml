<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<artifactId>parent</artifactId>
		<groupId>org.nasdanika.sdk.runtime.doc</groupId>
		<version>2026.11.0</version>
		<relativePath>..</relativePath>
	</parent>
	<artifactId>zephyr</artifactId>
	<name>Nasdanika Zephyr Books Look</name>
	<description>
		The look of the Nasdanika Zephyr Books: the PDF theme, the HTML stylesheets and the logo, under
		zephyr/ in the jar. The runtime's books use this directory directly; books in other
		repositories, such as the field notes and the stories, unpack the jar of the runtime release
		they are built with.
	</description>
	<build>
		<resources>
			<!-- The files stay where the runtime's books find them, at doc/zephyr; tools/ is not shipped -->
			<resource>
				<directory>${project.basedir}</directory>
				<targetPath>zephyr</targetPath>
				<includes>
					<include>css/**</include>
					<include>themes/**</include>
					<include>images/**</include>
					<include>README.md</include>
				</includes>
			</resource>
		</resources>
		<plugins>
			<!-- Central requires a Javadoc jar, and there is no code to generate one from -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<id>placeholder-javadoc</id>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>javadoc</classifier>
							<includes>
								<include>zephyr/README.md</include>
							</includes>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
