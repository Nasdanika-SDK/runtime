<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.nasdanika.sdk.runtime.doc.book.examples</groupId>
		<artifactId>parent</artifactId>
		<version>2026.10.0</version>
		<relativePath>..</relativePath>
	</parent>
	<artifactId>library</artifactId>
	<name>Library model</name>
	<description>
		Chapter "Models": a model defined in Xcore and generated by Maven, extending the runtime's core
		model. The later chapters use it as their domain.
	</description>

	<!-- tag::build[] -->
	<build>
		<plugins>
			<!-- Generates Java from src/main/resources/**/*.xcore into src-gen -->
			<plugin>
				<groupId>org.eclipse.xtext</groupId>
				<artifactId>xtext-maven-plugin</artifactId>
			</plugin>
			<!-- Adds src-gen as a source root -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
	<!-- end::build[] -->

	<!-- tag::dependencies[] -->
	<dependencies>
		<!-- NamedElement and the rest of the core model, which this model extends -->
		<dependency>
			<groupId>org.nasdanika.sdk.runtime.models</groupId>
			<artifactId>core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.nasdanika.sdk.runtime</groupId>
			<artifactId>common</artifactId>
		</dependency>
		<!-- Used by generated code and operation bodies written in Xcore -->
		<dependency>
			<groupId>org.eclipse.xtext</groupId>
			<artifactId>org.eclipse.xtext.xbase.lib</artifactId>
		</dependency>
		<dependency>
			<groupId>org.eclipse.emf</groupId>
			<artifactId>org.eclipse.emf.ecore.xcore.lib</artifactId>
		</dependency>
		<dependency>
			<groupId>org.nasdanika.sdk.runtime</groupId>
			<artifactId>emf-json</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<!-- end::dependencies[] -->
</project>
