<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
	    <artifactId>parent</artifactId>
	    <groupId>org.nasdanika.sdk.runtime</groupId>
	    <version>2026.10.0</version>
	    <relativePath>..</relativePath>
	</parent>
	<artifactId>bom</artifactId>
	<packaging>pom</packaging>
	<name>Nasdanika SDK Runtime BOM</name>
	<description>Bill of Materials (BOM) for Nasdanika SDK Runtime.</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<revision>${project.version}</revision>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
				<version>1.8.0</version>
				<configuration>
					<!-- Replaces the original pom.xml with the flattened version during
					install/deploy -->
					<updatePomFile>true</updatePomFile>

					<!-- 'resolveCiFriendliesOnly' is the safest mode for a Parent POM. 
                         It resolves variables like ${revision}, ${sha1}, and ${changelist} 
                         without stripping out other important sections of your child modules. -->
					<flattenMode>resolveCiFriendliesOnly</flattenMode>
				</configuration>
				<executions>
					<!-- Generate the flattened POM during the build -->
					<execution>
						<id>flatten</id>
						<phase>process-resources</phase>
						<goals>
							<goal>flatten</goal>
						</goals>
					</execution>
					<!-- Clean up the generated flattened POMs on 'mvn clean' -->
					<execution>
						<id>flatten.clean</id>
						<phase>clean</phase>
						<goals>
							<goal>clean</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<dependencyManagement>
	    <dependencies>
			<!-- Third party dependencies -->
			<dependency>
				<groupId>io.opentelemetry</groupId>
				<artifactId>opentelemetry-api</artifactId>
				<version>1.67.0</version>
				<scope>compile</scope>
			</dependency>			
			<dependency>
				<groupId>io.opentelemetry</groupId>
				<artifactId>opentelemetry-sdk</artifactId>
				<version>1.67.0</version>
				<scope>compile</scope>
			</dependency>			
			<dependency>
				<groupId>io.opentelemetry</groupId>
				<artifactId>opentelemetry-exporter-logging-otlp</artifactId>
				<version>1.67.0</version>
			</dependency>			
			<dependency>
				<groupId>io.opentelemetry</groupId>
				<artifactId>opentelemetry-sdk-testing</artifactId>
				<version>1.67.0</version>
				<scope>test</scope>
			</dependency>			
			<dependency>
				<groupId>io.leangen.geantyref</groupId>
				<artifactId>geantyref</artifactId>
				<version>2.0.1</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.emf</groupId>
				<artifactId>org.eclipse.emf.ecore</artifactId>
				<version>2.43.0</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.emf</groupId>
				<artifactId>org.eclipse.emf.ecore.xmi</artifactId>
				<version>2.41.0</version>
			</dependency>
			<dependency>
				<groupId>org.json</groupId>
				<artifactId>json</artifactId>
				<version>20260814</version>
			</dependency>
			<dependency>
				<groupId>org.yaml</groupId>
				<artifactId>snakeyaml</artifactId>
				<version>2.7</version>
			</dependency>		
			<dependency>
				<groupId>org.jsoup</groupId>
				<artifactId>jsoup</artifactId>
				<version>1.23.2</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jgit</groupId>
				<artifactId>org.eclipse.jgit</artifactId>
				<version>7.8.0.202609011348-r</version>
			</dependency>
			<!--
			<dependency>
				<groupId>org.nasdanika</groupId>
				<artifactId>xtext</artifactId>
				<version>2.43.0</version>
			</dependency>
			-->
			<dependency>
				<groupId>org.eclipse.xtext</groupId>
				<artifactId>org.eclipse.xtext.xbase.lib</artifactId>
				<version>2.44.0</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.emf</groupId>
				<artifactId>org.eclipse.emf.ecore.xcore.lib</artifactId>
				<version>1.8.0</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.emf</groupId>
				<artifactId>org.eclipse.emf.ecore.change</artifactId>
				<version>2.18.0</version>
			</dependency>       
			<dependency>
				<groupId>org.eclipse.emfcloud</groupId>
				<artifactId>emfjson-jackson</artifactId>
				<version>2.3.0</version>
				<scope>compile</scope>
			</dependency>
			<!--
				One version for all Jackson modules, jackson-dataformat-yaml included. Without it
				emfjson-jackson brings jackson-databind and jackson-annotations 2.12.6, which do not
				match jackson-core and have known vulnerabilities.
			-->
			<dependency>
				<groupId>com.fasterxml.jackson</groupId>
				<artifactId>jackson-bom</artifactId>
				<version>2.22.3</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.jline</groupId>
				<artifactId>jline</artifactId>
				<version>3.30.17</version>
			</dependency>
			<dependency>
				<groupId>org.apache.groovy</groupId>
				<artifactId>groovy-jsr223</artifactId>
				<version>5.1.3</version>
			</dependency>
			<dependency>
				<groupId>org.apache.groovy</groupId>
				<artifactId>groovy</artifactId>
				<version>5.1.3</version>
			</dependency>

			<!-- SDK modules -->
			<dependency>
				<groupId>org.nasdanika.sdk.runtime.models</groupId>
				<artifactId>bom</artifactId>
				<version>${revision}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>common</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>drawio</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>emf-json</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>picocli</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>volume</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>bootstrap</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>groovy</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>${project.groupId}</groupId>
