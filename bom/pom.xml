				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>all</artifactId>
				<version>${revision}</version>
				<type>pom</type>
			</dependency>
	    </dependencies>
	</dependencyManagement>
	
</project>
