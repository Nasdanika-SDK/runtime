<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.nasdanika.sdk.runtime.models.svg</groupId>
        <version>2026.10.0</version>
        <artifactId>parent</artifactId>
        <relativePath>..</relativePath>
    </parent>
    <artifactId>model</artifactId>
    <packaging>jar</packaging>
    <name>Nasdanika SDK Runtime SVG Model</name>
    <description>
        A pragmatic subset of SVG as an EMF model, annotated with ExtendedMetaData so that EMF's XML
        resource writes and reads SVG: the elements and presentation attributes generated diagrams
        need. Its Nasdanika Zephyr Book, "SVG Model", is built from src/docs/asciidoc with listings
        from the tests, among them a diagram laid out with ELK and written as SVG.
    </description>

    <properties>
        <!-- The Zephyr Book's file name: the artifactId, model, says too little -->
        <zephyr.book.name>svg-model-${project.version}-book</zephyr.book.name>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.xtext</groupId>
                <artifactId>xtext-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- The demo's diagram model is a test-only module -->
                    <argLine>@{argLine} --add-reads org.nasdanika.sdk.runtime.models.svg=org.nasdanika.sdk.runtime.models.diagram,org.nasdanika.sdk.runtime.models.core</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <dependencies>
		<dependency>
		    <groupId>org.nasdanika.sdk.runtime</groupId>
		    <artifactId>common</artifactId>
		    <version>${project.version}</version>
		</dependency>
		<dependency>
		    <groupId>org.eclipse.emf</groupId>
		    <artifactId>org.eclipse.emf.ecore</artifactId>
		</dependency>
		<dependency>
		    <groupId>org.eclipse.emf</groupId>
		    <artifactId>org.eclipse.emf.ecore.xmi</artifactId>
		</dependency>
		<!-- The Zephyr Book's demo: a diagram laid out with ELK, written as SVG -->
		<dependency>
		    <groupId>org.nasdanika.sdk.runtime.models.diagram</groupId>
		    <artifactId>elk</artifactId>
		    <version>${project.version}</version>
		    <scope>test</scope>
		</dependency>
        <dependency>
            <groupId>org.eclipse.xtext</groupId>
            <artifactId>org.eclipse.xtext.xbase.lib</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.emf</groupId>
            <artifactId>org.eclipse.emf.ecore.xcore.lib</artifactId>
        </dependency>
    </dependencies>
</project>
