@Ecore(
	nsURI="https://runtime.sdk.nasdanika.org/models/telemetry/traces", 
	nsPrefix="org.nasdanika.sdk.runtime.models.telemetry.traces"	
)
@GenModel(
    modelDirectory="/org.nasdanika.sdk.runtime.models.telemetry.model/src-gen",
    featureDelegation="Dynamic",
    complianceLevel="25",
    suppressGenModelAnnotations="false",
    copyrightFields="false",
    operationReflection="false",
    importOrganizing="true"
)
package org.nasdanika.sdk.runtime.models.telemetry.traces

import org.eclipse.emf.ecore.change.ChangeDescription
import org.nasdanika.sdk.runtime.models.telemetry.Resource
import org.nasdanika.sdk.runtime.models.telemetry.InstrumentationScope
import org.nasdanika.sdk.runtime.models.telemetry.KeyValue
import org.nasdanika.sdk.runtime.models.telemetry.logs.LogRecord

annotation "http://www.eclipse.org/emf/2002/Ecore" as Ecore
annotation "http://www.eclipse.org/emf/2002/GenModel" as GenModel
annotation "urn:org.nasdanika" as Nasdanika

/**
 * TracesData represents the traces export payload which can be serialized to different formats, e.g., OTLP/gRPC, JSON, and proto.
 */
class TracesData {
	/**
	 * An array of ResourceSpans. For data coming from a single resource this array will typically contain one element. Intermediary nodes that receive data from multiple origins typically batch the data before forwarding further.
	 */
	contains ResourceSpans[] resourceSpans
}

/**
 * A collection of ScopeSpans from a Resource.
 */
class ResourceSpans {
	/**
	 * The resource for the spans in this message. If this field is not set then no resource info is known.
	 */
	contains Resource resource
	/**
	 * A list of ScopeSpans that originate from a resource.
	 */
	contains ScopeSpans[] scopeSpans
	/**
	 * The URL of the schema that all spans in this message are following.
	 */
	String schemaUrl
}

/**
 * A collection of Spans produced by an InstrumentationScope.
 */
class ScopeSpans {
	/**
	 * The instrumentation scope information for the spans in this message. Semantically when InstrumentationScope isn't set, it is equivalent with an empty instrumentation scope name (unknown).
	 */
	contains InstrumentationScope scope
	/**
	 * A list of Spans that originate from an instrumentation scope.
	 */
	contains Span[] spans
	String schemaUrl
}

/**
 * SpanKind is the type of span. Can be used to specify additional relationships between spans in addition to a parent/child relationship.
 */
enum SpanKind {
	/**
	 * Unspecified. Do NOT use as default. Implementations MAY assume SpanKind to be INTERNAL when receiving UNSPECIFIED.
	 */
	SPAN_KIND_UNSPECIFIED
	/**
	 * Indicates that the span represents an internal operation within an application, as opposed to an operations happening at the boundaries of a process.
	 */
	SPAN_KIND_INTERNAL = 1
	/**
	 * Indicates that the span covers server-side handling of an RPC or other remote network request.
	 */
	SPAN_KIND_SERVER = 2
	/**
	 * Indicates that the span describes a request to some remote service.
	 */
	SPAN_KIND_CLIENT = 3
	/**
	 * Indicates that the span describes a producer sending a message to a broker. Unlike CLIENT and SERVER, there is often no direct critical-path latency relationship between producer and consumer spans.
	 */
	SPAN_KIND_PRODUCER = 4
	/**
	 * Indicates that the span describes consumer receiving a message from a broker. Like the PRODUCER kind, there is often no direct critical-path latency relationship between producer and consumer spans.
	 */
	SPAN_KIND_CONSUMER = 5
}

class SpanId {
	/**
	 * A unique identifier for a trace. All spans from the same trace share the same trace_id.
	 * The ID is a 16-byte array.
	 */
	String traceId
	/**
	 * A unique identifier for a span within a trace, assigned when the span is created.
	 * The ID is an 8-byte array.
	 */
	String spanId
	
}

/**
 * A Span represents a single operation performed by a single component of the system.
 * The next available field id is 17.
 */
class Span extends SpanId {
	/**
	 * trace_state conveys information about request position in multiple distributed tracing graphs. It is a vendor-specific format as described by the W3C Trace Context specification.
	 */
	String traceState
	/**
	 * The span_id of this span's parent span. If this is a root span, then this field must be empty. The ID is an 8-byte array.
	 */
	String parentSpanId
	/**
	 * A description of the span's operation.
	 * For example, the name can be a qualified method name or a file name and a line number where the operation is called. A best practice is to use the same display name at the same call point repeatably, so that users can filter and group spans based on the name.
	 */
	String[1] name
	/**
	 * Distinguishes between spans generated in a particular context.
	 */
	SpanKind kind
	/**
	 * start_time_unix_nano is the start time of the span. On the client side, this is the time kept by the local machine where the span execution starts. On the server side, this is the time when the server's application handler starts running.
	 * Value is UNIX Epoch time in nanoseconds since 00:00:00 UTC on 1 January 1970.
	 */
	long startTimeUnixNano
	/**
	 * end_time_unix_nano is the end time of the span. On the client side, this is the time kept by the local machine where the span execution ends. On the server side, this is the time when the server application handler stops running.
	 * Value is UNIX Epoch time in nanoseconds since 00:00:00 UTC on 1 January 1970.
	 */
	long endTimeUnixNano
	/**
	 * attributes is a collection of key/value pairs. Note, global attributes like server name can be set using the resource API.
	 */
	contains KeyValue[] attributes
	int droppedAttributesCount
	/**
	 * events is a collection of Event items.
	 */
	contains SpanEvent[] events
	int droppedEventsCount
	/**
	 * links is a collection of Links, which are references from this span to a span in the same or different trace.
	 */
	contains SpanLink[] links
	int droppedLinksCount
	/**
	 * An optional final status for this span. Semantically when Status isn't set, it means span's status code is unset, i.e. assume STATUS_CODE_UNSET (code = 0).
	 */
	contains SpanStatus status
	/**
	 * Flags, a bit field. 8 least significant bits are the trace flags as defined in W3C Trace Context specification.
	 */
	int flags
	contains ChangeDescription changeDescription
	contains LogRecord[] logRecords
	contains Span[] children keys traceId, spanId
	
	refers SpanReference[] referrers opposite span
}

/**
 * Event is a time-stamped annotation of the span, consisting of user-supplied text description and key-value pairs.
 */
class SpanEvent {
	/**
	 * time_unix_nano is the time the event occurred.
	 */
	long timeUnixNano
	/**
	 * name of the event. This field is semantically required to be set to non-empty string by OpenTelemetry API when the event is created explicitly by the instrumentation libraries.
	 */
	String[1] name
	/**
	 * attributes is a collection of attribute key/value pairs on the event.
	 */
	contains KeyValue[] attributes
	int droppedAttributesCount
}


class SpanReference extends SpanId {
	
	refers Span span opposite referrers
	
}

/**
 * A pointer from the current span to another span in the same trace or in a different trace. For example, this can be used in batching operations, where a single batch handler processes multiple requests from different traces or when the handler receives a request from a different project.
 */
class SpanLink extends SpanReference {
	
	String traceState
	/**
	 * attributes is a collection of attribute key/value pairs on the link.
	 */
	contains KeyValue[] attributes
	int droppedAttributesCount
	/**
	 * Flags, a bit field.
	 */
	int flags
}

/**
 * The Status type defines a logical error model that is suitable for different programming environments, including REST APIs and RPC APIs.
 */
class SpanStatus {
	/**
	 * A developer-facing human readable error message.
	 */
	String message
	/**
	 * The status code.
	 */
	StatusCode code
}

/**
 * For the semantics of status codes see https://github.com/open-telemetry/opentelemetry-specification/blob/main/specification/trace/api.md#set-status
 */
enum StatusCode {
	/**
	 * The default status.
	 */
	STATUS_CODE_UNSET
	/**
	 * The Span has been validated by an Application developer or Operator to have completed successfully.
	 */
	STATUS_CODE_OK = 1
	/**
	 * The Span contains an error.
	 */
	STATUS_CODE_ERROR = 2
}

// Change specializations

class FeatureChange extends org.eclipse.emf.ecore.change.FeatureChange, SpanReference {
	
}

class ResourceChange extends org.eclipse.emf.ecore.change.ResourceChange, SpanReference {
	
}
