@Ecore(
	nsURI="https://runtime.sdk.nasdanika.org/models/telemetry/logs", 
	nsPrefix="org.nasdanika.sdk.runtime.models.telemetry.logs"	
)
@GenModel(
    modelDirectory="/org.nasdanika.sdk.runtime.models.telemetry.model/src-gen",
    featureDelegation="Dynamic",
    complianceLevel="25",
    suppressGenModelAnnotations="false",
    copyrightFields="false",
    operationReflection="true",
    importOrganizing="true"
)
package org.nasdanika.sdk.runtime.models.telemetry.logs

import org.nasdanika.sdk.runtime.models.telemetry.Resource
import org.nasdanika.sdk.runtime.models.telemetry.InstrumentationScope
import org.nasdanika.sdk.runtime.models.telemetry.KeyValue
import org.nasdanika.sdk.runtime.models.telemetry.AnyValue

annotation "http://www.eclipse.org/emf/2002/Ecore" as Ecore
annotation "http://www.eclipse.org/emf/2002/GenModel" as GenModel
annotation "urn:org.nasdanika" as Nasdanika

/**
 * LogsData represents the logs export payload which can be serialized to different formats, e.g., OTLP/gRPC, JSON, and proto.
 */
class LogsData {
	/**
	 * An array of ResourceLogs.
	 */
	contains ResourceLogs[] resourceLogs
}

/**
 * A collection of ScopeLogs from a Resource.
 */
class ResourceLogs {
	contains Resource resource
	contains ScopeLogs[] scopeLogs
	String schemaUrl
}

/**
 * A collection of Logs produced by a Scope.
 */
class ScopeLogs {
	contains InstrumentationScope scope
	contains LogRecord[] logRecords
	String schemaUrl
}

/**
 * A log record according to OpenTelemetry Log Data Model: https://opentelemetry.io/docs/specs/otel/logs/data-model/
 */
class LogRecord {
	/**
	 * time_unix_nano is the time when the event occurred. Value is UNIX Epoch time in nanoseconds since 00:00:00 UTC on 1 January 1970.
	 */
	long timeUnixNano
	/**
	 * Time when the event was observed by the collection system.
	 */
	long observedTimeUnixNano
	/**
	 * Numerical value of the severity, normalized to values described in the log data model.
	 */
	SeverityNumber severityNumber
	/**
	 * The severity text (also known as log level). The original string representation as it is known at the source.
	 */
	String severityText
	/**
	 * A value containing the body of the log record.
	 */
	contains AnyValue body
	/**
	 * Additional attributes that describe the specific event occurrence.
	 */
	contains KeyValue[] attributes
	int droppedAttributesCount
	/**
	 * Flags, a bit field.
	 */
	int flags
	/**
	 * A unique identifier for a trace. All logs from the same trace share the same trace_id.
	 */
	String traceId
	/**
	 * A unique identifier for a span within a trace. If present, this log record is associated with a specific span.
	 */
	String spanId
	/**
	 * A unique identifier of an event. If present, this log record is an event: its attributes and body follow the event's semantic conventions.
	 */
	String eventName
}

/**
 * Possible values for LogRecord.SeverityNumber.
 */
enum SeverityNumber {
	/**
	 * UNSPECIFIED is the default SeverityNumber, it MUST not be used.
	 */
	SEVERITY_NUMBER_UNSPECIFIED
	SEVERITY_NUMBER_TRACE = 1
	SEVERITY_NUMBER_TRACE2 = 2
	SEVERITY_NUMBER_TRACE3 = 3
	SEVERITY_NUMBER_TRACE4 = 4
	SEVERITY_NUMBER_DEBUG = 5
	SEVERITY_NUMBER_DEBUG2 = 6
	SEVERITY_NUMBER_DEBUG3 = 7
	SEVERITY_NUMBER_DEBUG4 = 8
	SEVERITY_NUMBER_INFO = 9
	SEVERITY_NUMBER_INFO2 = 10
	SEVERITY_NUMBER_INFO3 = 11
	SEVERITY_NUMBER_INFO4 = 12
	SEVERITY_NUMBER_WARN = 13
	SEVERITY_NUMBER_WARN2 = 14
	SEVERITY_NUMBER_WARN3 = 15
	SEVERITY_NUMBER_WARN4 = 16
	SEVERITY_NUMBER_ERROR = 17
	SEVERITY_NUMBER_ERROR2 = 18
	SEVERITY_NUMBER_ERROR3 = 19
	SEVERITY_NUMBER_ERROR4 = 20
	SEVERITY_NUMBER_FATAL = 21
	SEVERITY_NUMBER_FATAL2 = 22
	SEVERITY_NUMBER_FATAL3 = 23
	SEVERITY_NUMBER_FATAL4 = 24
}