<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.nasdanika.sdk.runtime.models.telemetry</groupId>
		<version>2026.10.0</version>
		<artifactId>parent</artifactId>
		<relativePath>..</relativePath>
	</parent>
	<artifactId>exporters</artifactId>
	<packaging>jar</packaging>
	<name>Nasdanika SDK Runtime Telemetry Model Exporter</name>
	<description>
		OpenTelemetry SDK exporters that write spans, log records and metrics into the telemetry
		model, so that the telemetry of a unit of work is saved as models next to the models it
		describes, with recorded model changes in the spans that made them. The Nasdanika Zephyr
		Book of the telemetry model and its exporters, "Telemetry Model", is built from
		src/docs/asciidoc with listings from the tests.
	</description>

	<properties>
		<!-- The Zephyr Book's file name: the book covers the model and its exporters -->
		<zephyr.book.name>telemetry-model-${project.version}-book</zephyr.book.name>
	</properties>

	<dependencies>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>model</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.nasdanika.sdk.runtime</groupId>
			<artifactId>common</artifactId>
		</dependency>
		<dependency>
			<groupId>io.opentelemetry</groupId>
			<artifactId>opentelemetry-sdk</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>org.eclipse.emf</groupId>
			<artifactId>org.eclipse.emf.ecore.xmi</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
