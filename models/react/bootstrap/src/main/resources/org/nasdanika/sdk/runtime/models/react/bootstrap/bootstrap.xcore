@Ecore(
    nsURI="https://runtime.sdk.nasdanika.org/models/react/bootstrap",
	nsPrefix="org.nasdanika.sdk.runtime.models.react.bootstrap")

@GenModel(
	modelDirectory="/bootstrap/src-gen",
    featureDelegation="Dynamic",
    complianceLevel="25",
    suppressGenModelAnnotations="false",
    copyrightFields="false",
    operationReflection="true",
    importOrganizing="true"
)
/*
 * React Bootstrap (https://react-bootstrap.netlify.app/) technology model - core:
 * the base class, vocabulary shared by forms and components, and layout.
 * Targets react-bootstrap 2.10 and Bootstrap 5.3.
 *
 * Classes are React model library components, rendered reflectively from
 * "urn:org.nasdanika:react" annotations - see LibraryComponent in the React model.
 * Typed features cover static props and structure; expressions, event handlers and
 * dynamic children are JSX attributes and children of the library component.
 */
package org.nasdanika.sdk.runtime.models.react.bootstrap

import org.nasdanika.sdk.runtime.models.core.StringToStringMapEntry
import org.nasdanika.sdk.runtime.models.react.LibraryComponent
import org.nasdanika.sdk.runtime.models.typescript.NamedTypeReference

annotation "http://www.eclipse.org/emf/2002/Ecore" as Ecore
annotation "http://www.eclipse.org/emf/2002/GenModel" as GenModel
annotation "urn:org.nasdanika:react" as React

// --- Base ----------------------------------------------------------------

/*
 * Base of React Bootstrap components. Props every component passes to its element.
 *
 * Inherited model features - id, name, documentation, markers, ... - are not props.
 * Props with these names are features with other names and a prop annotation,
 * e.g. elementId for id and fieldName for name.
 */
@React(module="react-bootstrap")
abstract class BootstrapComponent extends LibraryComponent {
	/* DOM id */
	@React(prop="id")
	String elementId

	@React(prop="className", join=" ")
	String[] classes

	@React(style="true")
	contains StringToStringMapEntry[] style

	/* Element type to render as, e.g. "a" or "section" */
	String ^as

	/* Component to render as, e.g. Col for Form.Group as={Col}. Wins over as. */
	@React(prop="as")
	contains NamedTypeReference asComponent
}

/*
 * Text content of a component, rendered as a text child before other children.
 */
interface TextContent {
	@React(child="true")
	String content
}

// --- Vocabulary ----------------------------------------------------------

/* Theme colors - variant, bg, text and border props */
enum Variant {
	primary
	secondary
	success
	danger
	warning
	info
	light
	dark
}

enum ButtonVariant {
	primary
	secondary
	success
	danger
	warning
	info
	light
	dark
	link
	outlinePrimary as "outline-primary"
	outlineSecondary as "outline-secondary"
	outlineSuccess as "outline-success"
	outlineDanger as "outline-danger"
	outlineWarning as "outline-warning"
	outlineInfo as "outline-info"
	outlineLight as "outline-light"
	outlineDark as "outline-dark"
}

enum Size {
	sm
	lg
}

enum Breakpoint {
	xs
	sm
	md
	lg
	xl
	xxl
}

enum Direction {
	horizontal
	vertical
}

/*
 * Columns at a breakpoint - a Col or Form.Label column size, a Placeholder width.
 * Renders as the span alone if only the span is set: xs={6}, md="auto",
 * otherwise as an object: md={{ span: 4, offset: 2 }}.
 */
@React(shorthand="span")
class ColumnSize {
	@React(logical="true")
	Breakpoint breakpoint

	/* 1 - 12 */
	int span

	/* Natural width of the content */
	@React(prop="span", value="auto")
	boolean auto

	unsettable int offset

	unsettable int order
}

/*
 * Columns per row at a breakpoint: Row xs={1} md={3}.
 */
@React(shorthand="count")
class RowColumns {
	@React(logical="true")
	Breakpoint breakpoint

	@React(prop="count")
	int count

	@React(prop="count", value="auto")
	boolean auto
}

// --- Layout --------------------------------------------------------------

@React(component="ThemeProvider")
class ThemeProvider extends BootstrapComponent {
	/* Breakpoint names, largest first */
	String[] breakpoints
	String minBreakpoint
	/* "rtl" for right to left layouts */
	String dir
}

@React(component="Container")
class Container extends BootstrapComponent {
	boolean fluid

	/* Fluid until the breakpoint. Wins over fluid. */
	@React(prop="fluid")
	unsettable Breakpoint fluidUntil

	contains Row[] rows
}

@React(component="Row")
class Row extends BootstrapComponent {
	@React(key="breakpoint")
	contains RowColumns[] columnsPerRow

	contains Col[] columns
}

@React(component="Col")
class Col extends BootstrapComponent {
	@React(key="breakpoint")
	contains ColumnSize[] sizes
}

@React(component="Stack")
class Stack extends BootstrapComponent {
	unsettable Direction direction

	/* 0 - 5 */
	unsettable int gap
}

enum AspectRatio {
	r1x1 as "1x1"
	r4x3 as "4x3"
	r16x9 as "16x9"
	r21x9 as "21x9"
}

@React(component="Ratio")
class Ratio extends BootstrapComponent {
	unsettable AspectRatio aspectRatio
}

@React(component="Image")
class Image extends BootstrapComponent {
	String src
	String alt
	boolean fluid
	boolean rounded
	boolean roundedCircle
	boolean thumbnail
}

@React(component="Figure")
class Figure extends BootstrapComponent {
	contains FigureImage image
	contains FigureCaption caption
}

@React(component="Figure.Image")
class FigureImage extends Image {
}

@React(component="Figure.Caption")
class FigureCaption extends BootstrapComponent, TextContent {
}
