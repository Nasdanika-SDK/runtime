@Ecore(
    nsURI="https://runtime.sdk.nasdanika.org/models/react/bootstrap/components/content",
	nsPrefix="org.nasdanika.sdk.runtime.models.react.bootstrap.components.content")

@GenModel(
	modelDirectory="/bootstrap/src-gen",
    featureDelegation="Dynamic",
    complianceLevel="25",
    suppressGenModelAnnotations="false",
    copyrightFields="false",
    operationReflection="true",
    importOrganizing="true"
)
/*
 * React Bootstrap content components: alerts, badges, buttons, cards, list groups,
 * tables, progress bars, spinners, placeholders, accordions and carousels.
 * https://react-bootstrap.netlify.app/docs/components/accordion
 */
package org.nasdanika.sdk.runtime.models.react.bootstrap.components.content

import org.nasdanika.sdk.runtime.models.html.TableBody
import org.nasdanika.sdk.runtime.models.html.TableFoot
import org.nasdanika.sdk.runtime.models.html.TableHead
import org.nasdanika.sdk.runtime.models.react.JsxNode
import org.nasdanika.sdk.runtime.models.react.bootstrap.BootstrapComponent
import org.nasdanika.sdk.runtime.models.react.bootstrap.Breakpoint
import org.nasdanika.sdk.runtime.models.react.bootstrap.ButtonVariant
import org.nasdanika.sdk.runtime.models.react.bootstrap.ColumnSize
import org.nasdanika.sdk.runtime.models.react.bootstrap.Size
import org.nasdanika.sdk.runtime.models.react.bootstrap.TextContent
import org.nasdanika.sdk.runtime.models.react.bootstrap.Variant

annotation "http://www.eclipse.org/emf/2002/Ecore" as Ecore
annotation "http://www.eclipse.org/emf/2002/GenModel" as GenModel
annotation "urn:org.nasdanika:react" as React

// --- Alerts and badges ---------------------------------------------------

@React(component="Alert")
class Alert extends BootstrapComponent, TextContent {
	unsettable Variant variant

	/* Close button - pair with show and onClose attributes */
	boolean dismissible

	unsettable boolean show

	contains AlertHeading heading
}

@React(component="Alert.Heading")
class AlertHeading extends BootstrapComponent, TextContent {
}

@React(component="Alert.Link")
class AlertLink extends BootstrapComponent, TextContent {
	String href
}

@React(component="Badge")
class Badge extends BootstrapComponent, TextContent {
	unsettable Variant bg

	/* Text color, for light backgrounds */
	@React(prop="text")
	unsettable Variant textColor

	boolean pill
}

// --- Buttons -------------------------------------------------------------

enum ButtonType {
	button
	submit
	reset
}

@React(component="Button")
class Button extends BootstrapComponent, TextContent {
	unsettable ButtonVariant variant

	unsettable Size size

	unsettable ButtonType ^type

	boolean active

	boolean disabled

	/* Renders a link styled as a button */
	String href
}

@React(component="ButtonGroup")
class ButtonGroup extends BootstrapComponent {
	unsettable Size size

	boolean vertical

	contains JsxNode[] buttons
}

@React(component="ButtonToolbar")
class ButtonToolbar extends BootstrapComponent {
	contains ButtonGroup[] groups
}

enum CloseButtonVariant {
	white
}

@React(component="CloseButton")
class CloseButton extends BootstrapComponent {
	unsettable CloseButtonVariant variant

	boolean disabled
}

// --- Cards ---------------------------------------------------------------

@React(component="Card")
class Card extends BootstrapComponent {
	unsettable Variant bg

	@React(prop="text")
	unsettable Variant textColor

	unsettable Variant border

	contains CardHeader header

	contains CardImage image

	contains CardBody[] bodies

	contains CardFooter footer
}

@React(component="Card.Header")
class CardHeader extends BootstrapComponent, TextContent {
}

enum CardImageVariant {
	top
	bottom
}

@React(component="Card.Img")
class CardImage extends BootstrapComponent {
	unsettable CardImageVariant variant

	String src

	String alt
}

@React(component="Card.Body")
class CardBody extends BootstrapComponent {
	contains CardTitle title

	contains CardSubtitle subtitle

	contains CardText[] texts

	contains CardLink[] links
}

@React(component="Card.Title")
class CardTitle extends BootstrapComponent, TextContent {
}

@React(component="Card.Subtitle")
class CardSubtitle extends BootstrapComponent, TextContent {
}

@React(component="Card.Text")
class CardText extends BootstrapComponent, TextContent {
}

@React(component="Card.Link")
class CardLink extends BootstrapComponent, TextContent {
	String href
}

@React(component="Card.Footer")
class CardFooter extends BootstrapComponent, TextContent {
}

@React(component="CardGroup")
class CardGroup extends BootstrapComponent {
	contains Card[] cards
}

// --- List groups ---------------------------------------------------------

@React(component="ListGroup")
class ListGroup extends BootstrapComponent {
	boolean flush

	boolean numbered

	boolean horizontal

	/* Horizontal from the breakpoint up. Wins over horizontal. */
	@React(prop="horizontal")
	unsettable Breakpoint horizontalFrom

	contains ListGroupItem[] items
}

@React(component="ListGroup.Item")
class ListGroupItem extends BootstrapComponent, TextContent {
	unsettable Variant variant

	/* Hover and click styles; renders a button, or a link if href is set */
	boolean action

	boolean active

	boolean disabled

	String href
}

// --- Tables --------------------------------------------------------------

/*
 * Table with HTML sections. Dynamic rows: an Intrinsic TableBody with a JSX iterator as
 * a child of the table.
 */
@React(component="Table")
class Table extends BootstrapComponent {
	boolean striped

	boolean bordered

	boolean borderless

	boolean hover

	unsettable Size size

	unsettable Variant variant

	boolean responsive

	/* Responsive below the breakpoint. Wins over responsive. */
	@React(prop="responsive")
	unsettable Breakpoint responsiveBelow

	contains TableHead head

	contains TableBody[] bodies

	contains TableFoot foot
}

// --- Progress, spinners, placeholders ------------------------------------

@React(component="ProgressBar")
class ProgressBar extends BootstrapComponent {
	unsettable int now

	unsettable int min

	unsettable int max

	String label

	boolean visuallyHidden

	unsettable Variant variant

	boolean striped

	boolean animated

	/* Bars of a stacked progress bar, each with now */
	contains ProgressBar[] bars
}

enum SpinnerAnimation {
	border
	grow
}

@React(component="Spinner")
class Spinner extends BootstrapComponent, TextContent {
	unsettable SpinnerAnimation animation

	unsettable Variant variant

	unsettable Size size

	String role
}

enum PlaceholderAnimation {
	glow
	wave
}

enum PlaceholderSize {
	xs
	sm
	lg
}

/*
 * Loading placeholder. Width in columns with sizes, e.g. xs={6}.
 */
@React(component="Placeholder")
class Placeholder extends BootstrapComponent {
	unsettable PlaceholderAnimation animation

	unsettable Variant bg

	unsettable PlaceholderSize size

	@React(key="breakpoint")
	contains ColumnSize[] sizes

	contains Placeholder[] placeholders
}

@React(component="Placeholder.Button")
class PlaceholderButton extends BootstrapComponent {
	unsettable ButtonVariant variant

	@React(key="breakpoint")
	contains ColumnSize[] sizes
}

// --- Accordion -----------------------------------------------------------

@React(component="Accordion")
class Accordion extends BootstrapComponent {
	String defaultActiveKey

	boolean flush

	boolean alwaysOpen

	contains AccordionItem[] items
}

@React(component="Accordion.Item")
class AccordionItem extends BootstrapComponent {
	String eventKey

	contains AccordionHeader header

	contains AccordionBody body
}

@React(component="Accordion.Header")
class AccordionHeader extends BootstrapComponent, TextContent {
}

@React(component="Accordion.Body")
class AccordionBody extends BootstrapComponent, TextContent {
}

// --- Carousel ------------------------------------------------------------

enum CarouselVariant {
	dark
}

@React(component="Carousel")
class Carousel extends BootstrapComponent {
	unsettable boolean controls

	unsettable boolean indicators

	boolean fade

	/* Milliseconds between slides */
	unsettable int interval

	unsettable CarouselVariant variant

	contains CarouselItem[] items
}

/*
 * A slide. Its image or other content are children.
 */
@React(component="Carousel.Item")
class CarouselItem extends BootstrapComponent {
	unsettable int interval

	contains JsxNode content

	contains CarouselCaption caption
}

@React(component="Carousel.Caption")
class CarouselCaption extends BootstrapComponent {
	contains JsxNode[] content
}
