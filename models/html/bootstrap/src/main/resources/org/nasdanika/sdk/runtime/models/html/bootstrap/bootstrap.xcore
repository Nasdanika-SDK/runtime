@Ecore(
    nsURI="https://runtime.sdk.nasdanika.org/models/html/bootstrap",
	nsPrefix="org.nasdanika.sdk.runtime.models.html.bootstrap")

@GenModel(
	modelDirectory="/bootstrap/src-gen",
    featureDelegation="Dynamic",
    complianceLevel="25",
    suppressGenModelAnnotations="false",
    copyrightFields="false",
    operationReflection="true",
    importOrganizing="true"
)
/*
 * Bootstrap (https://getbootstrap.com/) technology model on top of the HTML model - core:
 * the base class, vocabulary shared by forms and components, themes, documents and layout.
 * The static HTML counterpart of the React Bootstrap model, with a similar structure.
 * Targets Bootstrap 5.3 and Bootswatch 5.3.
 *
 * Classes are HTML model library elements, rendered reflectively from "urn:org.nasdanika:html"
 * annotations - see LibraryElement in the HTML model. Responsive classes and components which
 * are more than one element - modals, accordions, dropdowns - are expanded to plain HTML by
 * BootstrapStructure. Generate with new Generator(new BootstrapStructure()), or with
 * new ReactGenerator(new BootstrapStructure()) to use these elements in React components.
 */
package org.nasdanika.sdk.runtime.models.html.bootstrap

import org.nasdanika.sdk.runtime.models.html.Document
import org.nasdanika.sdk.runtime.models.html.LibraryElement

annotation "http://www.eclipse.org/emf/2002/Ecore" as Ecore
annotation "http://www.eclipse.org/emf/2002/GenModel" as GenModel
annotation "urn:org.nasdanika:html" as Html

// --- Base ----------------------------------------------------------------

/*
 * Base of Bootstrap elements. id, classes, style and attributes are inherited from
 * the HTML element; classes are added to the classes the element contributes.
 */
abstract class BootstrapElement extends LibraryElement {
}

/*
 * Text content of an element, rendered as a text child after the children of
 * containment features and before contents.
 */
interface TextContent {
	@Html(child="true")
	String content
}

// --- Vocabulary ----------------------------------------------------------

/* Theme colors */
enum Variant {
	primary
	secondary
	success
	danger
	warning
	info
	light
	dark
}

enum ButtonVariant {
	primary
	secondary
	success
	danger
	warning
	info
	light
	dark
	link
	outlinePrimary as "outline-primary"
	outlineSecondary as "outline-secondary"
	outlineSuccess as "outline-success"
	outlineDanger as "outline-danger"
	outlineWarning as "outline-warning"
	outlineInfo as "outline-info"
	outlineLight as "outline-light"
	outlineDark as "outline-dark"
}

enum Size {
	sm
	lg
}

enum Breakpoint {
	xs
	sm
	md
	lg
	xl
	xxl
}

/* data-bs-theme of a document or an element */
enum ColorMode {
	light
	dark
}

/*
 * Bootstrap CSS, or a Bootswatch theme (https://bootswatch.com/).
 */
enum Theme {
	bootstrap
	brite
	cerulean
	cosmo
	cyborg
	darkly
	flatly
	journal
	litera
	lumen
	lux
	materia
	minty
	morph
	pulse
	quartz
	sandstone
	simplex
	sketchy
	slate
	solar
	spacelab
	superhero
	united
	vapor
	yeti
	zephyr
}

/*
 * Columns at a breakpoint - of a Col, of a horizontal form label or of a placeholder:
 * col-6, col-md-4 offset-md-2, col-lg-auto.
 */
class ColumnSize {
	Breakpoint breakpoint

	/* 1 - 12 */
	int span

	/* Natural width of the content */
	boolean auto

	unsettable int offset

	unsettable int order
}

/*
 * Columns per row at a breakpoint: row-cols-1 row-cols-md-3.
 */
class RowColumns {
	Breakpoint breakpoint

	int count

	boolean auto
}

// --- Document ------------------------------------------------------------

/*
 * A page with Bootstrap or a Bootswatch theme. The theme stylesheet is added to the head
 * before other stylesheets, the Bootstrap JavaScript bundle to the end of the body,
 * followed by initialization of tooltips and popovers if the page has any.
 */
class BootstrapDocument extends Document {
	@Html(logical="true")
	Theme theme

	/* Light or dark color mode of the page */
	@Html(attribute="data-bs-theme")
	unsettable ColorMode colorMode

	@Html(logical="true")
	String bootstrapVersion = "5.3.8"

	@Html(logical="true")
	String bootswatchVersion = "5.3.8"

	/* Dropdowns, modals, offcanvases, tooltips, ... need the Bootstrap JavaScript bundle */
	@Html(logical="true")
	boolean javaScript = "true"
}

// --- Layout --------------------------------------------------------------

/*
 * container, container-fluid, or container-{breakpoint}.
 */
@Html(tag="div")
class Container extends BootstrapElement {
	@Html(logical="true")
	boolean fluid

	/* Fluid until the breakpoint. Wins over fluid. */
	@Html(logical="true")
	unsettable Breakpoint fluidUntil

	contains Row[] rows
}

@Html(tag="div", classes="row")
class Row extends BootstrapElement {
	@Html(logical="true")
	contains RowColumns[] columnsPerRow

	/* Gutter, 0 - 5 */
	@Html(classes="g-{}")
	unsettable int gutter

	contains Col[] columns
}

/*
 * col, or column sizes.
 */
@Html(tag="div")
class Col extends BootstrapElement {
	@Html(logical="true")
	contains ColumnSize[] sizes
}

/*
 * vstack, or hstack if horizontal.
 */
@Html(tag="div")
class Stack extends BootstrapElement {
	@Html(logical="true")
	boolean horizontal

	/* 0 - 5 */
	@Html(classes="gap-{}")
	unsettable int gap
}

enum AspectRatio {
	r1x1 as "1x1"
	r4x3 as "4x3"
	r16x9 as "16x9"
	r21x9 as "21x9"
}

@Html(tag="div", classes="ratio")
class Ratio extends BootstrapElement {
	@Html(classes="ratio-{}")
	unsettable AspectRatio aspectRatio
}

@Html(tag="img", voidElement="true")
class Image extends BootstrapElement {
	String src

	String alt

	@Html(classes="img-fluid")
	boolean fluid

	@Html(classes="rounded")
	boolean rounded

	@Html(classes="rounded-circle")
	boolean roundedCircle

	@Html(classes="img-thumbnail")
	boolean thumbnail
}

@Html(tag="figure", classes="figure")
class Figure extends BootstrapElement {
	contains FigureImage image

	contains FigureCaption caption
}

@Html(classes="figure-img")
class FigureImage extends Image {
}

@Html(tag="figcaption", classes="figure-caption")
class FigureCaption extends BootstrapElement, TextContent {
}
