@Ecore(
	nsURI="https://runtime.sdk.nasdanika.org/models/file", 
	nsPrefix="org.nasdanika.sdk.runtime.models.file",
    invocationDelegates="https://runtime.sdk.nasdanika.org/models/file/delegate",
    settingDelegates="https://runtime.sdk.nasdanika.org/models/file/delegate"	
)
@GenModel(
    modelDirectory="/org.nasdanika.sdk.runtime.models.file.model/src-gen",
    featureDelegation="Dynamic",
    complianceLevel="25",
    suppressGenModelAnnotations="false",
    copyrightFields="false",
    operationReflection="true",
    importOrganizing="true"
)
package org.nasdanika.sdk.runtime.models.file

import org.eclipse.emf.ecore.EObject

annotation "http://www.eclipse.org/emf/2002/Ecore" as Ecore
annotation "http://www.eclipse.org/emf/2002/GenModel" as GenModel
annotation "urn:org.nasdanika" as Nasdanika

annotation "https://runtime.sdk.nasdanika.org/models/file/delegate" as Delegate
annotation "https://runtime.sdk.nasdanika.org/models/inference/tool-binding" as ToolBinding

/*
 * The state of a file. Snapshot serialization converts it to and from a string: base64 for small
 * content, a reference to a stored blob for large content (an open decision).
 */
type Content wraps org.nasdanika.sdk.runtime.volume.Content
type InputStream wraps java.io.InputStream
type OutputStream wraps java.io.OutputStream
type CharSequence wraps java.lang.CharSequence
type Instant wraps java.time.Instant

enum LineSeparator {
    LF
    CRLF
    CR
}

/**
 * A file, a directory or a link. Its parent is its container.
 */
abstract class Entry {

    String name

    /** Relative to the volume root, slash-separated, computed from the containment chain. */
    @Delegate
    derived readonly String path

    /** A content hash or a Git blob id, from the backend's stat. Null when unknown. */
    @Delegate
    derived readonly String hash

    @Delegate
    derived readonly Instant modified

    /** True when bound to a volume, false for a snapshot. */
    @Delegate
    derived readonly boolean live

    /** A detached copy of this entry and everything under it, with content materialized. */
    @Delegate
    op Entry snapshot()

    @Delegate
    op void delete()

    @Delegate
    op void moveTo(Directory target, String newName)

}

class Directory extends Entry {

    /** Lazy: filled from the backend on first access, invalidated by change reports. */
    contains Entry[] children

    /**
     * A page of children matching a glob, without materializing the rest: for very large
     * directories, where reading children would load everything.
     */
    @Delegate
    op Entry[] list(String glob, int offset, int limit)

    /** Resolves a relative path below this directory. Null when nothing is there. */
    @Delegate
    op Entry find(String path)

    @Delegate
    op Entry[] glob(String pattern)

    @Delegate
    op Match[] grep(String regex, String glob)

    @ToolBinding(provider="anthropic", ^type="text_editor_20250728", command="create")
    @Delegate
    op File createFile(String name, Content content)

    @Delegate
    op Directory createDirectory(String name)

}

class File extends Entry {

    /**
     * The one state. Getting it does no I/O; assigning it records content for the unit of work,
     * and bytes move when something reads it.
     */
    Content content

    /** The EMF content type identifier this file was classified as. */
    String contentType

    @Delegate
    derived readonly long size

    @Delegate
    op InputStream openStream()

    /** Pushes the bytes into a stream the caller owns. Preferred over openStream. */
    @Delegate
    op void writeTo(OutputStream out)

}

class TextFile extends File {

    String charset = "UTF-8"

    LineSeparator lineSeparator

    /**
     * The text view. Get decodes the content with the charset; set assigns content that encodes
     * when read. For large files, use the line operations.
     */
    @Delegate
    derived String text

    @Delegate
    op int lineCount()

    /** Lines startLine to endLine, one-based and inclusive; endLine -1 means to the end. */
    @ToolBinding(provider="anthropic", ^type="text_editor_20250728", command="view")
    @Delegate
    op String view(int startLine, int endLine)

    /**
     * Replaces exactly one occurrence. Fails on zero or several. Preserves the charset and the
     * line separator, so an edit is a small diff.
     */
    @ToolBinding(provider="anthropic", ^type="text_editor_20250728", command="str_replace")
    @Delegate
    op void replace(String oldText, String newText)

    /** Inserts after a line; 0 inserts at the beginning. */
    @ToolBinding(provider="anthropic", ^type="text_editor_20250728", command="insert")
    @Delegate
    op void insert(int afterLine, CharSequence text)

    @Delegate
    op Match[] grep(String regex)

}

/**
 * A zip or jar file. Opening it presents its entries as a directory over a zip volume. A zip
 * loaded through its resource factory is a snapshot Directory instead.
 */
class ArchiveFile extends File {

    @Delegate
    op Directory open()

}

/**
 * A link. In the model volume, non-containment references are links.
 */
class Link extends Entry {

    String target

}

/**
 * A search result line.
 */
class Match {

    String path

    int line

    String text

}
