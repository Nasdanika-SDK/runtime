<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.nasdanika.sdk.runtime.models.meta</groupId>
        <version>2026.10.0</version>
        <artifactId>parent</artifactId>
        <relativePath>..</relativePath>
    </parent>
    <artifactId>model</artifactId>
    <packaging>jar</packaging>
    <name>Nasdanika SDK Runtime Meta Model</name>
    <description>
        Meta, a language-neutral type system: packages, classes, features, operations and the type
        references between them, on the runtime's core model, written down once and projected to
        whatever consumers need. Vocabularies are loaded from and saved to a text syntax, .nmeta
        files, parsed with the ANTLR runtime. Its Nasdanika Zephyr Book, "Meta Model", is built
        from src/docs/asciidoc with listings from the tests, among them a bank's vocabulary written
        in the text syntax and a library's projected to a glossary and to Ecore.
    </description>

    <properties>
        <!-- The Zephyr Book's file name: the artifactId, model, says too little -->
        <zephyr.book.name>meta-model-${project.version}-book</zephyr.book.name>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.xtext</groupId>
                <artifactId>xtext-maven-plugin</artifactId>
            </plugin>
            <!--
                Generates the parser of the text syntax from src/main/grammar/Meta.g4 into src-gen,
                next to the Xcore-generated sources and, like them, committed. The parse tree is
                walked by hand in the resource package, so neither a listener nor a visitor is
                generated. The package is not exported.
            -->
            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
                <configuration>
                    <sourceDirectory>${basedir}/src/main/grammar</sourceDirectory>
                    <outputDirectory>${basedir}/src-gen/org/nasdanika/sdk/runtime/models/meta/parser</outputDirectory>
                    <listener>false</listener>
                    <visitor>false</visitor>
                    <treatWarningsAsErrors>true</treatWarningsAsErrors>
                    <arguments>
                        <argument>-package</argument>
                        <argument>org.nasdanika.sdk.runtime.models.meta.parser</argument>
                    </arguments>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
    <dependencies>
		<dependency>
		    <groupId>org.nasdanika.sdk.runtime.models</groupId>
		    <artifactId>core</artifactId>
		</dependency> 		
		<dependency>
		    <groupId>org.eclipse.emf</groupId>
		    <artifactId>org.eclipse.emf.ecore</artifactId>
		</dependency> 		
		<!-- The resource set contributor and the telemetry of .nmeta resources -->
		<dependency>
		    <groupId>org.nasdanika.sdk.runtime</groupId>
		    <artifactId>common</artifactId>
		    <version>${project.version}</version>
		</dependency>
		<!-- The parser of the text syntax -->
		<dependency>
		    <groupId>org.antlr</groupId>
		    <artifactId>antlr4-runtime</artifactId>
		</dependency>
        <dependency>
            <groupId>org.eclipse.xtext</groupId>
            <artifactId>org.eclipse.xtext.xbase.lib</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.emf</groupId>
            <artifactId>org.eclipse.emf.ecore.xcore.lib</artifactId>
        </dependency>
		<!-- The Zephyr Book saves vocabularies and instances as XMI; common brings it to the module path -->
		<dependency>
		    <groupId>org.eclipse.emf</groupId>
		    <artifactId>org.eclipse.emf.ecore.xmi</artifactId>
		</dependency>
    </dependencies>
</project>
