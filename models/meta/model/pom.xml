<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.nasdanika.sdk.runtime.models.meta</groupId>
        <version>2026.10.0</version>
        <artifactId>parent</artifactId>
        <relativePath>..</relativePath>
    </parent>
    <artifactId>model</artifactId>
    <packaging>jar</packaging>
    <name>Nasdanika SDK Runtime Meta Model</name>
    <description>
        Meta, a language-neutral type system: packages, classes, features, operations and the type
        references between them, on the runtime's core model, written down once and projected to
        whatever consumers need. Its Nasdanika Zephyr Book, "Meta Model", is built from
        src/docs/asciidoc with listings from the tests, among them a vocabulary projected to a
        glossary and to Ecore.
    </description>

    <properties>
        <!-- The Zephyr Book's file name: the artifactId, model, says too little -->
        <zephyr.book.name>meta-model-${project.version}-book</zephyr.book.name>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.xtext</groupId>
                <artifactId>xtext-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
    <dependencies>
		<dependency>
		    <groupId>org.nasdanika.sdk.runtime.models</groupId>
		    <artifactId>core</artifactId>
		</dependency> 		
		<dependency>
		    <groupId>org.eclipse.emf</groupId>
		    <artifactId>org.eclipse.emf.ecore</artifactId>
		</dependency> 		
        <dependency>
            <groupId>org.eclipse.xtext</groupId>
            <artifactId>org.eclipse.xtext.xbase.lib</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.emf</groupId>
            <artifactId>org.eclipse.emf.ecore.xcore.lib</artifactId>
        </dependency>
		<!-- The Zephyr Book saves vocabularies and instances as XMI -->
		<dependency>
		    <groupId>org.eclipse.emf</groupId>
		    <artifactId>org.eclipse.emf.ecore.xmi</artifactId>
		    <scope>test</scope>
		</dependency>
    </dependencies>
</project>
