<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- Change these to the vocabulary's own coordinates -->
	<groupId>org.example.vocabulary</groupId>
	<artifactId>vocabulary</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>Vocabulary</name>
	<description>A business vocabulary in Nasdanika Meta's text syntax, src/main/meta/*.nmeta.</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>25</maven.compiler.release>
		<!-- The Nasdanika SDK Runtime release; its BOM aligns the versions of everything it uses -->
		<nasdanika.runtime.version>2026.10.0</nasdanika.runtime.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.nasdanika.sdk.runtime</groupId>
				<artifactId>bom</artifactId>
				<version>${nasdanika.runtime.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.nasdanika.sdk.runtime.models.meta</groupId>
			<artifactId>model</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>6.1.3</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.16.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.6.0</version>
			</plugin>
		</plugins>
	</build>
</project>
