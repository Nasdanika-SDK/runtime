@Ecore(
   	nsURI="https://runtime.sdk.nasdanika.org/models/presentation", 
	nsPrefix="org.nasdanika.sdk.runtime.models.presentation")
@GenModel(
	modelDirectory="/model/src-gen",
    featureDelegation="Dynamic",
    complianceLevel="25",
    suppressGenModelAnnotations="false",
    copyrightFields="false",
    operationReflection="true",
    importOrganizing="true"
)
package org.nasdanika.sdk.runtime.models.presentation

import org.nasdanika.sdk.runtime.models.diagram.Diagram
import org.nasdanika.sdk.runtime.models.diagram.Node
import org.nasdanika.sdk.runtime.models.diagram.Connection
import org.nasdanika.sdk.runtime.models.diagram.DiagramPackage
import org.nasdanika.sdk.runtime.common.DerivedSubsetEList
import org.eclipse.emf.ecore.InternalEObject

annotation "http://www.eclipse.org/emf/2002/Ecore" as Ecore
annotation "http://www.eclipse.org/emf/2002/GenModel" as GenModel
annotation "urn:org.nasdanika" as Nasdanika

class Presentation extends Diagram {
    /* Slide size in points. */
    double width
    double height

    refers derived transient volatile Slide[] slides get {
        new DerivedSubsetEList<Slide>(
            typeof(Slide),
            this as InternalEObject,
            PresentationPackage.PRESENTATION__SLIDES,
            DiagramPackage.DIAGRAM_ELEMENT__CHILDREN) // TODO - exclude master slides
    }

    refers derived transient volatile MasterSlide[] masterSlides get {
        new DerivedSubsetEList<MasterSlide>(
            typeof(MasterSlide),
            this as InternalEObject,
            PresentationPackage.PRESENTATION__MASTER_SLIDES,
            DiagramPackage.DIAGRAM_ELEMENT__CHILDREN)
    }

}

/*
 * A slide IS a diagram: shapes are diagram nodes, connectors are diagram connections,
 * which makes slides convertible to/from Draw.io, Visio, PlantUML.
 */
class Slide extends Diagram {
    refers MasterSlide master
    boolean hidden
    /*
     * Speaker notes. Also the primary annotation carrier for composability:
     * a conventional YAML/JSON block in notes is parsed on load into diagram
     * properties / modelElement bindings and re-emitted on save.
     */
    contains Notes notes
}

class MasterSlide extends Slide {
}

class Notes {
    String text
}

/* ---- Shared shape taxonomy ---- */

abstract class Shape extends Node {
    /* Z-order on the slide. */
    int order
    double rotation
    boolean flipHorizontal
    boolean flipVertical
}

class GroupShape extends Shape {
}

class TextShape extends Shape {
    contains Paragraph[] paragraphs
}

class Paragraph {
    contains TextRun[] runs
    int indentLevel
    String alignment
}

class TextRun {
    String text
    String fontFamily
    double fontSize
    boolean bold
    boolean italic
    boolean underline
    /* #RRGGBB */
    String color
    String hyperlink
}

class ImageShape extends Shape {
    /* Image location � URI resolved against the resource, or embedded part name. */
    String location
    String contentType
}

class MediaShape extends Shape {
    String location
    String contentType
}

class TableShape extends Shape {
    contains Row[] rows
}

class Row {
    contains Cell[] cells
    double height
}

class Cell {
    contains Paragraph[] paragraphs
    int columnSpan = "1"
    int rowSpan = "1"
}

/* A connector between shapes - a first-class diagram connection. */
class ConnectorShape extends Connection {
}

