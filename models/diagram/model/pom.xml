<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.nasdanika.sdk.runtime.models.diagram</groupId>
        <version>2026.10.0</version>
        <artifactId>parent</artifactId>
        <relativePath>..</relativePath>
    </parent>
    <artifactId>model</artifactId>
    <packaging>jar</packaging>
    <name>Nasdanika SDK Runtime Diagram Model</name>

    <properties>
        <!-- The Zephyr Book's file name: the artifactId, model, says too little -->
        <zephyr.book.name>diagram-model-${project.version}-book</zephyr.book.name>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.xtext</groupId>
                <artifactId>xtext-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
            </plugin>
            <!--
                The Zephyr Book's tests read Draw.io diagrams with the drawio module, whose API mentions
                java.xml types. Tests are patched into this module, which does not read java.xml.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>--add-modules</arg>
                                <arg>java.xml</arg>
                                <arg>--add-reads</arg>
                                <arg>org.nasdanika.sdk.runtime.models.diagram=java.xml</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} --add-modules java.xml,java.desktop --add-reads org.nasdanika.sdk.runtime.models.diagram=java.xml</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <dependencies>
		<dependency>
		    <groupId>org.nasdanika.sdk.runtime.models</groupId>
		    <artifactId>core</artifactId>
		</dependency> 		
		<dependency>
		    <groupId>org.eclipse.emf</groupId>
		    <artifactId>org.eclipse.emf.ecore</artifactId>
		</dependency> 		
        <dependency>
            <groupId>org.eclipse.xtext</groupId>
            <artifactId>org.eclipse.xtext.xbase.lib</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.emf</groupId>
            <artifactId>org.eclipse.emf.ecore.xcore.lib</artifactId>
        </dependency>
        <!-- The Zephyr Book's tests: YAML resources, and diagrams loaded from Draw.io -->
        <dependency>
            <groupId>org.nasdanika.sdk.runtime</groupId>
            <artifactId>emf-json</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.nasdanika.sdk.runtime</groupId>
            <artifactId>drawio</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
