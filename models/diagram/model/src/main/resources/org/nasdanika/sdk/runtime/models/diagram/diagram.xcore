@Ecore(
   	nsURI="https://runtime.sdk.nasdanika.org/models/diagram", 
	nsPrefix="org.nasdanika.sdk.runtime.models.diagram")
@GenModel(
	modelDirectory="/model/src-gen",
    featureDelegation="Dynamic",
    complianceLevel="25",
    suppressGenModelAnnotations="false",
    copyrightFields="false",
    operationReflection="true",
    importOrganizing="true"
)
package org.nasdanika.sdk.runtime.models.diagram

import org.eclipse.emf.ecore.EObject
import org.nasdanika.sdk.runtime.models.core.NamedElement
import org.nasdanika.sdk.runtime.models.core.StringToStringMapEntry
import org.nasdanika.sdk.runtime.models.core.StringIdentity

annotation "http://www.eclipse.org/emf/2002/Ecore" as Ecore
annotation "http://www.eclipse.org/emf/2002/GenModel" as GenModel
annotation "urn:org.nasdanika" as Nasdanika

/* ---- Geometry (OMG DC-inspired) ---- */

class Point {
    double x
    double y
}

class Bounds extends Point {
    double width
    double height
}

/* ---- Core ---- */

abstract class DiagramElement extends NamedElement, StringIdentity { 

    /*
     * Generic string properties — carrier for annotations/semantic mappings
     * (same composability technique as the Nasdanika Markdown model).
     */
    contains StringToStringMapEntry[] properties
    /*
     * Semantic model elements this notation element depicts - the "other" model.
     * Named after the semantic model / representation model distinction rather than
     * after OMG DI's single-valued "modelElement", because a diagram element is
     * itself a model element.
     *
     * Multi-valued because a notation element may depict a collection rather than a
     * single object: a "Forest" box mapping to a collection of trees, a container
     * standing for a group of people or resources, or a shape representing an
     * iteration over something.
     */
    refers EObject[] semanticElements

    // TODO - semantic elements selector - nxcore.Evaluator. E.g. read a directory or execute a SQL/JQL query. 
    // derived allSemanticElements reference - a union of semanticElements and selected semantic elements

    contains DiagramElement[] children keys ^id
}

class Diagram extends DiagramElement {

}

class Layer extends DiagramElement {
    boolean visible = "true"
    boolean locked
}

/**
 * Something connections can attach to - Node, Port
 */
abstract class Connectable extends DiagramElement {

    refers Connection[] incomingConnections opposite target 
    refers Connection[] outgoingConnections opposite source 

}

/* A positioned element: shape on a slide/page. */
class Node extends Connectable {
    contains Bounds bounds
    contains Port[] ports keys ^id
}

/* Connection attachment point on a node (pragmatic extension over OMG DD). */
class Port extends Connectable {
    /* Relative position on the owner, 0..1 in each dimension. */
    contains Point location
}

class Connection extends DiagramElement {
    refers Connectable source opposite outgoingConnections
    refers Connectable target opposite incomingConnections
    contains Point[] waypoints
}

class Label extends Node {
    String text
}

