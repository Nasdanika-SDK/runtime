@Ecore(
   	nsURI="https://runtime.sdk.nasdanika.org/models/drawio",
	nsPrefix="org.nasdanika.sdk.runtime.models.drawio")
@GenModel(
	modelDirectory="/model/src-gen",
    featureDelegation="Dynamic",
    complianceLevel="25",
    suppressGenModelAnnotations="false",
    copyrightFields="false",
    operationReflection="true",
    importOrganizing="true"
)
package org.nasdanika.sdk.runtime.models.drawio

import org.eclipse.emf.ecore.InternalEObject
import org.nasdanika.sdk.runtime.common.DerivedSubsetEList
import org.nasdanika.sdk.runtime.models.core.StringToStringMapEntry
import org.nasdanika.sdk.runtime.models.diagram.DiagramPackage
import org.nasdanika.sdk.runtime.models.presentation.Presentation
import org.nasdanika.sdk.runtime.models.presentation.Slide

annotation "http://www.eclipse.org/emf/2002/Ecore" as Ecore
annotation "http://www.eclipse.org/emf/2002/GenModel" as GenModel
annotation "urn:org.nasdanika" as Nasdanika

/*
 * A Draw.io document as a model, on the presentation and diagram models: a document is a
 * presentation, a page is a slide, layers, nodes and connections are their diagram namesakes.
 * The model holds what makes Draw.io Draw.io, and inherits the rest.
 *
 * Loaded and saved through the runtime's Draw.io API by the resource contents handler in
 * org.nasdanika.sdk.runtime.models.drawio.resource, for .drawio files and for PNG and SVG images
 * with the document embedded (.drawio.png, .drawio.svg).
 *
 * What maps where:
 *   - label        -> ModelElement.label as written (HTML if the style says html=1), and its text
 *                     in DiagramElement.name
 *   - tooltip      -> documentation, from core's Documented
 *   - properties   -> attributes, from core's Attributed (the <object> wrapper's attributes)
 *   - style        -> ModelElement.style, an ordered map
 *   - tags         -> Page.tags and ModelElement.tags
 *   - link         -> ModelElement.link
 *   - geometry     -> Node.bounds, relative to the parent node, and Connection.waypoints
 */

/* mxfile */
class Document extends Presentation {
    String host
    String agent
    String version
    boolean compressed

    /* The slides of the document, typed as pages. */
    refers derived transient volatile Page[] pages get {
        new DerivedSubsetEList<Page>(
            typeof(Page),
            this as InternalEObject,
            DrawioPackage.DOCUMENT__PAGES,
            DiagramPackage.DIAGRAM_ELEMENT__CHILDREN)
    }
}

/* ============================================================================
 * Link targets
 * ============================================================================ */

/*
 * Something a link can point at - a Page or a ModelElement.
 *
 * Mirrors org.nasdanika.sdk.runtime.drawio.LinkTarget in the Java API, which is likewise the
 * common supertype of Page and ModelElement.
 */
interface LinkTarget {

}

/* mxfile/diagram - a page is a slide is a diagram. Its children are layers. */
class Page extends Slide, LinkTarget {
    /* mxGraphModel attributes worth keeping. */
    double dx
    double dy
    double pageWidth
    double pageHeight
    double gridSize

    /*
     * The tags of the page: the union of the tag names on its elements. Draw.io does not
     * declare tags anywhere, they are names on cells. A tag's id is its name.
     */
	contains Tag[] tags

	/*
	 * The animation of the page. [PLANNED] Not loaded or saved yet.
	 */
	contains Animation animation

    /* The children of the page, typed as layers. */
    refers derived transient volatile Layer[] layers get {
        new DerivedSubsetEList<Layer>(
            typeof(Layer),
            this as InternalEObject,
            DrawioPackage.PAGE__LAYERS,
            DiagramPackage.DIAGRAM_ELEMENT__CHILDREN)
    }

}

/*
 * Common supertype of the Draw.io layers, nodes and connections: the cells, which the Java API
 * calls ModelElement. They carry a label, a style, a link and tags. Their properties are the
 * attributes, and their tooltip the documentation, of DiagramElement.
 */
interface ModelElement extends LinkTarget {

	/*
	 * The label as Draw.io stores it: HTML when the style has html=1. DiagramElement.name is its
	 * text. When the label is not set, saving writes the name.
	 */
	String label

	/*
	 * The style as an ordered map of keys and values, such as rounded -> 1 and fillColor -> #dae8fc.
	 * A key without a value, such as ellipse or text at the start of a style, has a null value.
	 * Unknown keys are kept, so a document round-trips.
	 */
	contains StringToStringMapEntry[] style

	/*
	 * The style as Draw.io writes it: key=value pairs, and keys without values, joined with ';'.
	 */
	derived readonly String styleString get {
		org.nasdanika.sdk.runtime.models.drawio.resource.Styles.format(style)
	}

    /*
     * The 'link' attribute, parsed. Null when the element has no link.
     *
     * Containment rather than an attribute because a link is either a target or a
     * script - see AbstractLink.
     */
    contains AbstractLink link

    /*
     * The tags of the element, contained by its page.
     */
    refers Tag[] tags opposite elements

}

class Layer extends org.nasdanika.sdk.runtime.models.diagram.Layer, ModelElement {
}

/* A shape. Its children are the nodes and connections inside it. */
class Node extends org.nasdanika.sdk.runtime.models.diagram.Node, ModelElement {
    boolean collapsed
    boolean visible = "true"
}

/*
 * A connection. Its children are its labels, nodes that Draw.io positions along it. Exit and
 * entry points (exitX, exitY, entryX, entryY) stay in the style. [PLANNED] Connection points as
 * ports.
 */
class Connection extends org.nasdanika.sdk.runtime.models.diagram.Connection, ModelElement {
    boolean visible = "true"
}

/*
 * A Draw.io tag. Its id is its name.
 *
 * Tags matter more here than they look: the in-browser viewer can filter by them
 * with no server involved, and custom actions can target them, so a tag is the
 * cheapest way to say "this group of shapes moves together".
 */
class Tag extends org.nasdanika.sdk.runtime.models.core.StringIdentity {

    /* Elements on the page carrying this tag - the inverse of ModelElement.tags. */
    refers ModelElement[] elements opposite tags
}

/* ============================================================================
 * Links
 * ============================================================================ */

/*
 * Base class for the contents of the 'link' attribute.
 *
 * Draw.io puts three different things in that one attribute - an ordinary URL, a
 * data: URI naming a page or an element, or a JSON blob of custom actions - so a
 * single polymorphic reference is a more honest model than three optional
 * attributes, and it keeps "what happens when this shape is clicked" answerable
 * with one question.
 */
abstract class AbstractLink {
}

/*
 * A link that is stored and used verbatim: an http(s) URL, a mailto:, a relative
 * path, a data: URI this model does not interpret, custom actions (data:action/json,...)
 * until Actions are loaded, and a page or element link whose target is not in the document.
 *
 * Anything not recognised as a CustomLink or a SpelLink lands here, which
 * is what keeps the round trip lossless.
 */
class SimpleLink extends AbstractLink {
    String target
}

/*
 * How a page or an element is picked out by a selector.
 *
 * ID and NAME are the two qualified forms in the notation - 'id,' and 'name,'.
 */
enum SelectorType {
    ID
    NAME
    PROPERTY
}

/*
 * The Nasdanika extended link notation, which widens Draw.io's page linking into
 * element linking and cross-document linking:
 *
 *     data:page/id,<page id>
 *     data:page/name,<url encoded page name>
 *     data:element/id,[<page selector>/]<element id>
 *     data:element/name,[<page selector>/]<url encoded label>
 *
 * with an optional document URI before a '#', resolved relative to the URI of the
 * containing document. A page selector is 'id,<page id>' or 'name,<page name>'.
 *
 * The resolved references are the point of modelling this at all: "what links to this
 * component" is a getReferrers query rather than a text search. Links within the document
 * are loaded as custom links with their targets; links into other documents are loaded as
 * simple links. [PLANNED] Targets in other documents of the resource set.
 *
 * The selectors are kept alongside the target so that saving reproduces the notation the
 * author wrote. A custom link with a target and no selectors is saved by id.
 */
class CustomLink extends AbstractLink {

    /*
     * URI of the document containing the target - the part before '#'.
     * Blank for a link within the same document.
     */
    String resource

    /* The target, resolved. A Page for a page link, a ModelElement for an element link. */
    refers LinkTarget target

    /* How the page was selected. Blank pageSelector means "the current page". */
    SelectorType pageSelectorType
    String pageSelector

    /* How the element was selected. Blank for a page link. */
    SelectorType elementSelectorType
    String elementSelector
}

/*
 * data:spel,<expression>
 *
 * A link computed by a SpEL expression evaluated against the element it sits on,
 * so a shape can decide at generation time where it points. Loaded and saved, not evaluated.
 */
class SpelLink extends AbstractLink {
    String expression
}

/* ============================================================================
 * Custom actions and animations [PLANNED]
 *
 * The vocabulary of Draw.io's custom actions, as typed objects whose cells, layers and
 * tags are references. Not loaded or saved yet: custom actions in links are loaded as
 * simple links, so they round-trip as text.
 *
 * Draw.io's docs use "action" and "effect" more or less interchangeably; the JSON
 * calls them actions, so the model does too.
 *
 * Two carriers, one vocabulary:
 *   - Actions   - attached to an element, run when it is clicked.
 *   - Animation - attached to a page, runs on load, optionally looping.
 * ============================================================================ */

/*
 * A named sequence of actions in an element's link:
 *
 *     {"title": "Show the failure path", "actions": [ ... ]}
 */
class Actions extends AbstractLink {
    /* Optional label shown for the action. */
    String title
    contains Action[] actions
}

/*
 * Page-level animation:
 *
 *     {"animation": {"enabled": true, "loop": true, "steps": [ ... ]}}
 */
class Animation {
    boolean enabled = "true"
    boolean loop
    contains Action[] steps
}

/*
 * One step of a sequence.
 *
 * Draw.io steps carry a 'transient' flag which, when set to false, persists the
 * step's changes into the model instead of only affecting the view. It is modelled
 * as persistChanges on the actions that support it (see PersistableAction) rather
 * than as 'transient', because that word is an Xcore feature modifier and a Java
 * keyword, and the inverted name reads better than an escaped one.
 */
abstract class Action {
    /*
     * Run together with the previous step rather than after it - the JSON
     * "immediate": true. This is how several effects are made to happen at once.
     */
    boolean immediate
}

/* Pause for the given number of milliseconds - the JSON {"wait": 500}. */
class Wait extends Action {
    int delay
}

/* How several tag names are combined when selecting cells. */
enum TagsMatch {
    OR
    AND
}

/*
 * Base for every action that selects the cells it applies to.
 *
 * The selector is the reason this is worth modelling rather than storing as a
 * string: 'cells', 'layers', and 'tags' are identifiers in the JSON, and as
 * references they survive a rename, break a build when the target is deleted, and
 * let a generator say "animate the elements depicting this service" instead of
 * hand-assembling a list of ids.
 */
abstract class TargetedAction extends Action {

    /* Cells the action applies to. */
    refers ModelElement[] cells

    /* Select every cell - the JSON "cells": ["*"]. */
    boolean allCells

    /* Layers the action applies to; descendants are included. */
    refers Layer[] layers

    /* Tags the action applies to. */
    refers Tag[] tags

    TagsMatch tagsMatch = "OR"

    /* Removed from the result of the above. */
    refers ModelElement[] excludeCells
}

/*
 * Actions whose changes can be written back into the model rather than only
 * affecting the current view - Draw.io's "transient": false.
 */
abstract class PersistableAction extends TargetedAction {
    /* JSON "transient": false. Default (false here) means view-only. */
    boolean persistChanges
}

/* ---- Visibility ---- */

/* Make the cells visible - opacity 1. */
class Show extends PersistableAction {
}

/* Make the cells invisible - opacity 0. */
class Hide extends PersistableAction {
}

/* Flip each cell's opacity between 0 and 1. */
class Toggle extends PersistableAction {
}

/* Set opacity outright, 0..1. */
class SetOpacity extends TargetedAction {
    double opacity
}

/* ---- Transitions ---- */

/*
 * Animated effects. 'delay' is the JSON "delay" in milliseconds - how long the
 * transition takes.
 */
abstract class TransitionEffect extends TargetedAction {
    int delay
}

/* Animate opacity 0 -> 1. */
class FadeIn extends TransitionEffect {
}

/* Animate opacity 1 -> 0. */
class FadeOut extends TransitionEffect {
}

/* Animate opacity to a specific value, 0..1. */
class FadeTo extends TransitionEffect {
    double opacity
}

/* Reveal with a wipe. */
class WipeIn extends TransitionEffect {
}

/* Hide with a reverse wipe. */
class WipeOut extends TransitionEffect {
}

/* Scale-and-fade entrance. */
class PopIn extends TransitionEffect {
}

/* Scale-and-fade exit. */
class PopOut extends TransitionEffect {
}

/* ---- Style ---- */

/*
 * Set one style key - the JSON {"style": {"key": "fillColor", "value": "#d5e8d4"}}.
 */
class SetStyle extends PersistableAction {
    String key
    String value
}

/*
 * Flip a style key between its current value and a default -
 * {"toggleStyle": {"key": "fillColor", "defaultValue": "none"}}.
 */
class ToggleStyle extends PersistableAction {
    String key
    String defaultValue
}

/* Pulse a colour over the cells. */
class Highlight extends TargetedAction {
    /* #RRGGBB. */
    String color
    /* Percent, 0..100 - Draw.io's own unit here, unlike the 0..1 opacity elsewhere. */
    int opacity
    /* Milliseconds. */
    int duration
}

/* Whether a flow animation is toggled, forced on, or forced off. */
enum FlowMode {
    TOGGLE
    START
    STOP
}

/* Moving dashes along connections - the JSON {"flow": {"start": true}}. */
class Flow extends TargetedAction {
    FlowMode mode = "TOGGLE"
}

/* ---- Navigation ---- */

/* Select the cells on the canvas. */
class Select extends TargetedAction {
}

/* Scroll the cells into view. */
class Scroll extends TargetedAction {
    boolean smooth
}

/* Move the viewport to a rectangle. */
class Viewbox extends Action {
    contains org.nasdanika.sdk.runtime.models.diagram.Bounds bounds
    boolean smooth
}

/* Open a link - a URL, or another page via data:page/id,<id>. */
class Open extends Action {
    contains AbstractLink target
}

/* ---- Tags ---- */

/*
 * Change which tags are visible - {"tags": {"toggle": [], "hidden": [], "visible": []}}.
 */
class TagsAction extends Action {
    refers Tag[] toggle
    refers Tag[] hidden
    refers Tag[] visible
}
