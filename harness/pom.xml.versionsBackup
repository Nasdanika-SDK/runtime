<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<artifactId>parent</artifactId>
		<groupId>org.nasdanika.sdk.runtime</groupId>
		<version>2026.10.0</version>
		<relativePath>..</relativePath>
	</parent>
	<artifactId>harness</artifactId>
	<packaging>jar</packaging>
	<name>Nasdanika SDK Runtime Harness</name>
	<description>
		An HTTP server that is up while code runs against it, in one trace with the code's requests:
		end-to-end traceability for tests, demos and walk-throughs. The module's Zephyr Book takes
		its listings from the tests.
	</description>

	<properties>
		<zephyr.book.name>harness-${project.version}-book</zephyr.book.name>
		<zephyr.epub.skip>false</zephyr.epub.skip>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>${project.groupId}</groupId>
				<artifactId>bom</artifactId>
				<version>${project.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!--
						Tests are patched into this module. Surefire puts the telemetry model on the
						module path and its exporters, which need the OpenTelemetry SDK, on the class
						path; the tests read the model.
					-->
					<argLine>@{argLine} --add-reads org.nasdanika.sdk.runtime.harness=org.nasdanika.sdk.runtime.models.telemetry</argLine>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>volume</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.nasdanika.sdk.runtime.models.telemetry</groupId>
			<artifactId>exporters</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>emf-json</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
